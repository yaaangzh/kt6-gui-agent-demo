{
  "manifest_version": 3,
  "name": "KT6 Browser Agent",
  "version": "0.8.0",
  "description": "Select the exact current tab and run confirmed KT6 workflows through Browser Harness in your daily Chrome.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "action": {
    "default_title": "Open KT6 Browser Agent"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
