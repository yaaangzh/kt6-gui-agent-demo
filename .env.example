# Copy this file to .env and fill only the route you need. Never commit real keys.

# Natural-language Action Plan model (OpenAI-compatible API)
KT6_MODEL_API_PROVIDER=<provider-or-internal-gateway>
KT6_MODEL_API_BASE_URL=http://<approved-model-gateway>/v1
KT6_MODEL_API_KEY=<secret>
KT6_MODEL_API_MODEL=<exact-model-name>
KT6_MODEL_API_ALLOWED_HOSTS=<approved-model-gateway-host>
KT6_MODEL_API_MAX_TOKENS=4096
KT6_MODEL_API_TIMEOUT_SECONDS=60

# Optional local Canvas supplement. It does not call an LLM. Leave unset when
# DOM/CDP perception is sufficient for the target pages.
# KT6_VISION_DRIVER=local_cv_ocr

# Optional Canvas vision for feature/eval-browser-harness. This is a separate
# OpenAI-compatible API route and never falls back to KT6_MODEL_API_*.
# hybrid = CV/OCR first, then image + bounded CV context only if needed.
# openai_compatible = image model directly, without local CV.
# The selected model must accept image_url content parts and return JSON.
# KT6_VISION_DRIVER=hybrid
# KT6_VISION_API_PROVIDER=<vision-provider-or-internal-gateway>
# KT6_VISION_API_BASE_URL=http://<approved-vision-gateway>/v1
# KT6_VISION_API_KEY=<secret>
# KT6_VISION_API_MODEL=<image-capable-model-name>
# KT6_VISION_API_ALLOWED_HOSTS=<approved-vision-gateway-host>
# KT6_VISION_API_MAX_TOKENS=4096
# KT6_VISION_API_TIMEOUT_SECONDS=60

# Optional UI Graph planning through the same model endpoint (eval-current)
# KT6_UI_GRAPH_REASONER_DRIVER=openai_compatible
# KT6_UI_GRAPH_REASONER_TIMEOUT_SECONDS=60

# Browser Use (eval-browser-use)
# KT6_BROWSER_USE_CDP_URL=http://127.0.0.1:9222

# Browser Harness over the user's daily Chrome (feature/eval-browser-harness)
# The Windows launcher sets this automatically. Enable remote debugging from
# chrome://inspect/#remote-debugging; no fixed CDP port or dedicated profile is used.
# KT6_BROWSER_EXECUTION_DRIVER=browser_harness
# Public HTTP(S) target pages work without per-domain configuration. Local,
# private, link-local and reserved addresses are blocked by default.
# Hostname resolution is compatible with proxy synthetic DNS (198.18.0.0/15).
# Enable only for isolated localhost/RFC1918 test pages; link-local stays blocked.
# KT6_EXECUTION_ALLOW_PRIVATE_NETWORKS=0
# The planner reuses the KT6_MODEL_API_* route above. Browser Harness supplies
# the live DOM/CDP capture and fixed type/click transport.
# Set only when running the real-browser unittest; the E2E CLI does not need it.
# KT6_RUN_BROWSER_E2E=1

# UI-TARS grounding endpoint (eval-ui-tars)
# KT6_UI_TARS_API_PROVIDER=ui-tars
# KT6_UI_TARS_API_BASE_URL=http://<approved-ui-tars-service>/v1
# KT6_UI_TARS_API_KEY=<secret>
# KT6_UI_TARS_MODEL=<exact-ui-tars-model-name>
# KT6_UI_TARS_API_ALLOWED_HOSTS=<approved-ui-tars-service-host>
# KT6_UI_TARS_CDP_URL=http://127.0.0.1:9222
